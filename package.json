{
  "name": "mbs-cloud-kitchen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "create-admin": "tsx scripts/create-admin.ts",
    "knowledge:index": "tsx scripts/index-knowledge.ts",
    "knowledge:setup-vector": "tsx scripts/setup-vector-index.ts",
    "analyze": "cross-env ANALYZE=true npm run build",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "og:generate": "tsx scripts/generate-og-image.ts",
    "lighthouse": "lhci autorun",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:headers": "tsx scripts/check-headers.ts",
    "fixture:generate": "tsx scripts/generate-test-fixture.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/react": "^1.0.0",
